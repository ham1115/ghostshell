# =====================================================================
#  GHOSTSHELL :: Relay Nine — sshd configuration
#
#  Passwords are the game mechanic, so password auth is on by design.
#  Everything that could be used to pivot out of the container, tunnel
#  traffic through it, or reach another player's session is off.
# =====================================================================

Port 2222
AddressFamily any
ListenAddress 0.0.0.0

# --- authentication --------------------------------------------------
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM yes
MaxAuthTries 6
MaxSessions 10
MaxStartups 40:30:80
LoginGraceTime 30

# Only the six segment accounts may log in. Any future service account
# added to the image is therefore not reachable over SSH.
AllowUsers level0 level1 level2 level3 level4 level5

# --- no pivoting, no tunnelling, no forwarding ------------------------
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
GatewayPorts no
PermitTunnel no
PermitOpen none
X11Forwarding no

# ~/.ssh/rc is player-controlled territory; do not execute it.
PermitUserRC no
PermitUserEnvironment no

# --- presentation ----------------------------------------------------
Banner /etc/ghostshell-banner
PrintMotd no
PrintLastLog no
# pam_motd prints /etc/motd, so PrintMotd stays off to avoid doubling it.

# --- hygiene ---------------------------------------------------------
StrictModes yes
ClientAliveInterval 300
ClientAliveCountMax 3
Compression no
TCPKeepAlive yes
Subsystem sftp internal-sftp
AcceptEnv LANG LC_*
